{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:runtime-manifest:v3",
  "title": "Robotics runtime manifest v3",
  "description": "Observed runtime facts with an extensible configuration-artifact registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "runtime_id", "generated_at", "oci_image", "components", "host",
    "ros", "render", "workload", "execution", "authorization", "data_plane", "security",
    "lifecycle_states", "physical_targets", "clock"
  ],
  "properties": {
    "schema_version": {"const": "runtime-manifest.v3"},
    "runtime_id": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/runtime_id"},
    "generated_at": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/generated_at"},
    "oci_image": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/oci_image"},
    "components": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/components"},
    "configuration_artifacts": {"type": "array", "items": {"$ref": "#/$defs/configurationArtifact"}},
    "host": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/host"},
    "ros": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/ros"},
    "gazebo": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/gazebo"},
    "render": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/render"},
    "workload": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/workload"},
    "execution": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/execution"},
    "authorization": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/authorization"},
    "data_plane": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/data_plane"},
    "security": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/security"},
    "lifecycle_states": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/lifecycle_states"},
    "physical_targets": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/physical_targets"},
    "clock": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/clock"},
    "extensions": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/properties/extensions"}
  },
  "allOf": [
    {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/allOf/0"},
    {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/allOf/1"}
  ],
  "$defs": {
    "configurationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128},
        "sha256": {"$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/$defs/imported__runtime-manifest__sha256"}
      }
    }
  }
}
