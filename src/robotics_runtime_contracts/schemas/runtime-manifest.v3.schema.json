{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:runtime-manifest:v3",
  "title": "Robotics runtime manifest v3",
  "description": "Observed runtime identity with cryptographically authorized physical target facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "generated_at",
    "oci_image",
    "components",
    "host",
    "ros",
    "render",
    "workload",
    "execution",
    "authorization",
    "data_plane",
    "security",
    "lifecycle_states",
    "physical_targets",
    "clock"
  ],
  "properties": {
    "schema_version": {
      "const": "runtime-manifest.v3"
    },
    "runtime_id": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/identifier"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "oci_image": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/ociImage"
    },
    "components": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/components"
    },
    "host": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/host"
    },
    "ros": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/ros"
    },
    "gazebo": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/gazebo"
    },
    "render": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/render"
    },
    "workload": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v2#/$defs/workload"
    },
    "execution": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/execution"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "data_plane": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/dataPlane"
    },
    "security": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/security"
    },
    "lifecycle_states": {
      "type": "array",
      "items": {
        "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/lifecycleState"
      }
    },
    "physical_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/physicalTarget"
      }
    },
    "clock": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/clock"
    },
    "extensions": {
      "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          },
          "physical_targets": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "enum": [
                  "hil",
                  "real_robot"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "mode": {
                "const": "verified_execution_permit"
              }
            }
          },
          "security": {
            "properties": {
              "profile": {
                "const": "sros2_enforce"
              },
              "strategy": {
                "const": "Enforce"
              }
            }
          },
          "execution": {
            "properties": {
              "time_mode": {
                "const": "hardware_realtime"
              },
              "data_source": {
                "const": "live_target"
              },
              "plant_backend": {
                "const": "real_hardware"
              }
            }
          },
          "physical_targets": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "permit_sha256",
            "execution_verification_sha256",
            "trust_policy_sha256"
          ],
          "properties": {
            "mode": {
              "const": "verified_execution_permit"
            },
            "permit_sha256": {
              "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/sha256"
            },
            "execution_verification_sha256": {
              "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/sha256"
            },
            "trust_policy_sha256": {
              "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/sha256"
            }
          }
        }
      ]
    },
    "physicalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "scope",
        "identity_kind",
        "identity_sha256",
        "preflight_evidence_sha256"
      ],
      "properties": {
        "target_id": {
          "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/identifier"
        },
        "scope": {
          "enum": [
            "compute",
            "sensor",
            "controller"
          ]
        },
        "identity_kind": {
          "enum": [
            "udev_serial",
            "pci_device",
            "mavlink_system_component",
            "x509_spki",
            "tpm_ek",
            "vendor_soc"
          ]
        },
        "identity_sha256": {
          "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/sha256"
        },
        "preflight_evidence_sha256": {
          "$ref": "urn:robotics-runtime-contracts:runtime-manifest:v1#/$defs/sha256"
        },
        "stable_device_path": {
          "type": "string",
          "pattern": "^/dev/[^*?\\s]+$"
        }
      }
    }
  }
}
