{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:model-artifact-manifest",
  "title": "Robotics model artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "source",
    "target",
    "build",
    "compatibility",
    "numerical_conformance"
  ],
  "properties": {
    "schema_version": {"const": "model-artifact-manifest.v1"},
    "model_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
    "source": {"$ref": "#/$defs/modelArtifact"},
    "target": {"$ref": "#/$defs/modelArtifact"},
    "build": {"$ref": "#/$defs/build"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "numerical_conformance": {"$ref": "#/$defs/numericalConformance"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
      "additionalProperties": {"type": "object"}
    }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "element_type", "shape"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "element_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "integer", "minimum": -1},
              {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 64}
            ]
          }
        }
      }
    },
    "modelArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "format",
        "media_type",
        "runtime_family",
        "execution_provider",
        "inputs",
        "outputs"
      ],
      "properties": {
        "uri": {"type": "string", "format": "uri", "maxLength": 2048},
        "sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "format": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 255},
        "runtime_family": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
        "execution_provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/tensor"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/tensor"}}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "configuration_sha256", "source_artifact_sha256"],
      "properties": {
        "tool": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "configuration_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"},
        "source_artifact_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"},
        "calibration_dataset_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable", "hardware"],
      "properties": {
        "portable": {"type": "boolean"},
        "hardware": {
          "type": "array",
          "items": {"$ref": "#/$defs/hardware"}
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "device_family"],
      "properties": {
        "vendor": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
        "device_family": {"type": "string", "minLength": 1, "maxLength": 128},
        "driver_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "attributes": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "additionalProperties": {"type": ["string", "number", "integer", "boolean"]}
        }
      }
    },
    "numericalConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_sha256",
        "reference_artifact_sha256",
        "sample_dataset_sha256",
        "absolute_tolerance",
        "relative_tolerance",
        "passed"
      ],
      "properties": {
        "report_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"},
        "reference_artifact_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"},
        "sample_dataset_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "passed": {"const": true}
      }
    }
  }
}
