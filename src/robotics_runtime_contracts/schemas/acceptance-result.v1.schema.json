{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:acceptance-result",
  "title": "Robotics acceptance result v1",
  "description": "Run-scoped acceptance result with attributed extension assertions and symmetric ROS endpoints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "run_id", "scenario_id", "domain_id",
    "verdict_scope", "evaluation_mode", "unevaluated", "time_authority_observation", "scenario_sha256",
    "runtime_manifest_sha256", "started_at", "finished_at", "monotonic_duration_sec",
    "status", "assertion_results", "observed_ros_graph", "forbidden_graph_observation",
    "execution", "runtime_observation", "evaluators", "authorization", "workload", "lifecycle_states", "clock_observation",
    "shutdown", "evidence"
  ],
  "properties": {
    "schema_version": {"const": "acceptance-result.v1"},
    "result_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/result_id"},
    "run_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/run_id"},
    "scenario_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/scenario_id"},
    "domain_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/domain_id"},
    "verdict_scope": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/verdict_scope"},
    "evaluation_mode": {"enum": ["live", "offline"]},
    "unevaluated": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/unevaluated"},
    "time_authority_observation": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/time_authority_observation"},
    "scenario_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/scenario_sha256"},
    "runtime_manifest_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/runtime_manifest_sha256"},
    "model_manifest_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/model_manifest_sha256"},
    "dataset_manifest_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/dataset_manifest_sha256"},
    "started_at": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/started_at"},
    "finished_at": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/finished_at"},
    "monotonic_duration_sec": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/monotonic_duration_sec"},
    "status": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/status"},
    "assertion_results": {"type": "array", "items": {"$ref": "#/$defs/assertionResult"}},
    "observed_ros_graph": {"$ref": "#/$defs/observedRosGraph"},
    "forbidden_graph_observation": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/forbidden_graph_observation"},
    "execution": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/execution"},
    "runtime_observation": {"$ref": "#/$defs/runtimeObservation"},
    "evaluators": {"type": "array", "items": {"$ref": "#/$defs/evaluatorObservation"}},
    "authorization": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/authorization"},
    "workload": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/workload"},
    "lifecycle_states": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/lifecycle_states"},
    "clock_observation": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/clock_observation"},
    "hardware_clock_observation": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/hardware_clock_observation"},
    "shutdown": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/shutdown"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "extensions": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/properties/extensions"}
  },
  "allOf": [
    {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/allOf/0"},
    {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/allOf/1"},
    {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/allOf/2"},
    {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/allOf/3"},
    {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/allOf/4"},
    {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/allOf/5"}
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "uri", "media_type", "sha256", "size_bytes", "retention_class"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128},
        "uri": {"type": "string", "format": "uri", "maxLength": 2048},
        "immutable_revision": {"type": "string", "minLength": 1, "maxLength": 1024},
        "receipt_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__sha256"},
        "media_type": {"$ref": "urn:robotics-runtime-contracts:v1:evidence-index#/$defs/mediaType"},
        "sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__sha256"},
        "size_bytes": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__evidence/properties/size_bytes"},
        "retention_class": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__evidence/properties/retention_class"},
        "segment_index": {"type": "integer", "minimum": 0}
      }
    },
    "assertionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "source", "status", "observed_value", "unit"],
      "properties": {
        "assertion_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__identifier"},
        "source": {"enum": ["core", "product"]},
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
        "status": {"enum": ["passed", "failed", "error", "skipped"]},
        "observed_value": {"type": ["number", "integer", "string", "boolean", "null"]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "maxLength": 4096},
        "evidence_sha256": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__sha256"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "product"}}, "required": ["source"]},
          "then": {"required": ["namespace", "evidence_sha256"]}
        }
      ]
    },
    "observedEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "server_nodes", "client_nodes"],
      "properties": {
        "name": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__rosName"},
        "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*/(?:srv|action)/[A-Za-z][A-Za-z0-9_]*$"},
        "server_nodes": {"type": "integer", "minimum": 0},
        "client_nodes": {"type": "integer", "minimum": 0}
      }
    },
    "observedRosGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_for_sec", "topics", "services", "actions"],
      "properties": {
        "stable_for_sec": {"type": "number", "minimum": 0},
        "topics": {"type": "array", "items": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__observedTopic"}},
        "services": {"type": "array", "items": {"$ref": "#/$defs/observedEndpoint"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/observedEndpoint"}}
      }
    },
    "runtimeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
          "execution_subject_digest",
          "ros_domain_id",
          "rmw_implementation",
          "rmw_version",
          "security_enabled",
        "security_strategy"
      ],
      "properties": {
        "execution_subject_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "ros_domain_id": {"type": "integer", "minimum": 0, "maximum": 232},
        "rmw_implementation": {"type": "string", "pattern": "^rmw_[a-z0-9_]+$", "maxLength": 128},
        "rmw_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "middleware_configuration_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__sha256"},
        "security_enabled": {"type": "boolean"},
        "security_strategy": {"enum": ["none", "Permissive", "Enforce"]},
        "enclave": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "evaluatorObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "entry_point", "distribution", "version", "artifact_sha256", "receipt_sha256"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
        "entry_point": {"type": "string", "minLength": 1, "maxLength": 256},
        "distribution": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__sha256"},
        "receipt_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:acceptance-result-core#/$defs/imported__acceptance-result__sha256"}
      }
    }
  }
}
