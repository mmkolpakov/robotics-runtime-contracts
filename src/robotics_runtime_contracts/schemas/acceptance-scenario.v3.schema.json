{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:acceptance-scenario:v3",
  "title": "Robotics acceptance scenario v3",
  "description": "Acceptance contract with explicit authorization and forbidden ROS interfaces for physical observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "execution",
    "authorization",
    "forbidden_ros_graph",
    "seed",
    "timeouts",
    "expected_ros_graph",
    "assertions",
    "time_policy",
    "data_plane_policy",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-scenario.v3"
    },
    "scenario_id": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/identifier"
    },
    "execution": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/execution"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "forbidden_ros_graph": {
      "$ref": "#/$defs/forbiddenRosGraph"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "dataset_manifest_sha256": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/sha256"
    },
    "model_manifest_sha256": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/sha256"
    },
    "timeouts": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/timeouts"
    },
    "expected_ros_graph": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/expectedRosGraph"
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/assertion"
      }
    },
    "time_policy": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/timePolicy"
    },
    "data_plane_policy": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/dataPlanePolicy"
    },
    "evidence_policy": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/evidencePolicy"
    },
    "extension_schemas": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/extensionSchema"
      }
    },
    "extensions": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "hardware_scope": {
                "maxItems": 0
              },
              "physical_effect": {
                "const": "none"
              }
            }
          },
          "authorization": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "hil"
              }
            }
          }
        }
      },
      "then": {
        "$ref": "#/$defs/physicalHilConstraints"
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "real_robot"
              }
            }
          }
        }
      },
      "then": {
        "$ref": "#/$defs/realObservationConstraints"
      }
    }
  ],
  "$defs": {
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "permit_schema",
            "verification_schema",
            "trust_policy_sha256",
            "two_party_approval"
          ],
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            },
            "permit_schema": {
              "const": "execution-permit.v2"
            },
            "verification_schema": {
              "const": "execution-verification.v1"
            },
            "trust_policy_sha256": {
              "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/sha256"
            },
            "two_party_approval": {
              "const": true
            }
          }
        }
      ]
    },
    "forbiddenRosGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "services",
        "actions"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/rosName"
          },
          "uniqueItems": true
        }
      }
    },
    "physicalHilConstraints": {
      "properties": {
        "execution": {
          "properties": {
            "physical_effect": {
              "const": "none"
            },
            "hardware_scope": {
              "minItems": 1,
              "not": {
                "contains": {
                  "const": "actuator"
                }
              }
            },
            "data_source": {
              "const": "live_target"
            },
            "plant_backend": {
              "const": "real_hardware"
            },
            "time_mode": {
              "const": "hardware_realtime"
            },
            "data_plane_profile": {
              "const": "secure_shared_memory"
            },
            "security_profile": {
              "const": "sros2_enforce"
            }
          }
        },
        "authorization": {
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            }
          }
        }
      }
    },
    "realObservationConstraints": {
      "properties": {
        "execution": {
          "properties": {
            "physical_effect": {
              "const": "observation"
            },
            "hardware_scope": {
              "minItems": 1,
              "not": {
                "contains": {
                  "const": "actuator"
                }
              }
            },
            "data_source": {
              "const": "live_target"
            },
            "plant_backend": {
              "const": "real_hardware"
            },
            "time_mode": {
              "const": "hardware_realtime"
            },
            "data_plane_profile": {
              "const": "secure_shared_memory"
            },
            "security_profile": {
              "const": "sros2_enforce"
            }
          }
        },
        "authorization": {
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            }
          }
        }
      }
    }
  }
}
