{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:acceptance-scenario:v3",
  "title": "Robotics acceptance scenario v3",
  "description": "Acceptance contract with attributed metrics, measured time-authority thresholds, explicit authorization, forbidden ROS interfaces, and an explicit stepped-simulation skip budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "execution",
    "authorization",
    "forbidden_ros_graph",
    "seed",
    "timeouts",
    "expected_ros_graph",
    "assertions",
    "time_policy",
    "data_plane_policy",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-scenario.v3"
    },
    "scenario_id": {
      "$ref": "#/$defs/imported__acceptance-scenario__identifier"
    },
    "execution": {
      "$ref": "#/$defs/imported__acceptance-scenario__execution"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "forbidden_ros_graph": {
      "$ref": "#/$defs/forbiddenRosGraph"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "dataset_manifest_sha256": {
      "$ref": "#/$defs/imported__acceptance-scenario__sha256"
    },
    "model_manifest_sha256": {
      "$ref": "#/$defs/imported__acceptance-scenario__sha256"
    },
    "timeouts": {
      "$ref": "#/$defs/imported__acceptance-scenario__timeouts"
    },
    "expected_ros_graph": {
      "$ref": "#/$defs/imported__acceptance-scenario__expectedRosGraph"
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imported__acceptance-scenario__assertion"
      }
    },
    "time_policy": {
      "$ref": "#/$defs/imported__acceptance-scenario__timePolicy"
    },
    "data_plane_policy": {
      "$ref": "#/$defs/imported__acceptance-scenario__dataPlanePolicy"
    },
    "evidence_policy": {
      "$ref": "#/$defs/imported__acceptance-scenario__evidencePolicy"
    },
    "extension_schemas": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/imported__acceptance-scenario__extensionSchema"
      }
    },
    "extensions": {
      "$ref": "#/$defs/imported__acceptance-scenario__extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "plant_backend": {
                "const": "interface_mock"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "test_intent": {
                "const": "interface_smoke"
              },
              "physical_effect": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "data_source": {
                "const": "gazebo"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              },
              "plant_backend": {
                "const": "gazebo_physics"
              },
              "time_mode": {
                "enum": [
                  "simulation_realtime",
                  "simulation_stepped"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "data_source": {
                "const": "mcap_playback"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "dataset_manifest_sha256"
        ],
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              },
              "plant_backend": {
                "const": "recorded_data"
              },
              "time_mode": {
                "const": "playback_clocked"
              },
              "physical_effect": {
                "const": "none"
              }
            }
          },
          "time_policy": {
            "required": [
              "playback_rate",
              "min_clock_hz",
              "message_order",
              "qos_overrides_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "time_mode": {
                "const": "simulation_stepped"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              },
              "test_intent": {
                "enum": [
                  "interface_smoke",
                  "functional"
                ]
              }
            }
          },
          "time_policy": {
            "required": [
              "step_size_sec",
              "max_skipped_steps"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "time_policy": {
            "not": {
              "required": [
                "max_skipped_steps"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "time_mode": {
                "const": "simulation_realtime"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "time_policy": {
            "required": [
              "min_realtime_factor",
              "max_deadline_miss_ratio"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "time_mode": {
                "const": "hardware_realtime"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "time_policy": {
            "required": [
              "clock_sync_protocol",
              "max_clock_offset_ms",
              "max_clock_drift_ppm",
              "max_message_age_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "test_intent": {
                "const": "performance"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "time_mode": {
                "enum": [
                  "simulation_realtime",
                  "hardware_realtime"
                ]
              }
            }
          },
          "time_policy": {
            "required": [
              "max_deadline_miss_ratio"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "data_plane_profile": {
                "const": "local_high_throughput"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "security_profile": {
                "const": "none"
              }
            }
          },
          "data_plane_policy": {
            "properties": {
              "shm_transport": {
                "const": true
              },
              "private_ipc": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "data_plane_profile": {
                "const": "secure_shared_memory"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "security_profile": {
                "const": "sros2_enforce"
              }
            }
          },
          "data_plane_policy": {
            "properties": {
              "shm_transport": {
                "const": true
              },
              "data_sharing": {
                "const": false
              },
              "private_ipc": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "simulation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "hardware_scope": {
                "maxItems": 0
              },
              "physical_effect": {
                "const": "none"
              }
            }
          },
          "authorization": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "hil"
              }
            }
          }
        }
      },
      "then": {
        "$ref": "#/$defs/physicalHilConstraints"
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "target_environment": {
                "const": "real_robot"
              }
            }
          }
        }
      },
      "then": {
        "$ref": "#/$defs/realObservationConstraints"
      }
    }
  ],
  "$defs": {
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "permit_schema",
            "verification_schema",
            "trust_policy_sha256",
            "two_party_approval"
          ],
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            },
            "permit_schema": {
              "const": "execution-permit.v1"
            },
            "verification_schema": {
              "const": "execution-verification.v1"
            },
            "trust_policy_sha256": {
              "$ref": "#/$defs/imported__acceptance-scenario__sha256"
            },
            "two_party_approval": {
              "const": true
            }
          }
        }
      ]
    },
    "forbiddenRosGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "services",
        "actions"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imported__acceptance-scenario__rosName"
          },
          "uniqueItems": true
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imported__acceptance-scenario__rosName"
          },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imported__acceptance-scenario__rosName"
          },
          "uniqueItems": true
        }
      }
    },
    "physicalHilConstraints": {
      "properties": {
        "execution": {
          "properties": {
            "physical_effect": {
              "const": "none"
            },
            "hardware_scope": {
              "minItems": 1,
              "not": {
                "contains": {
                  "const": "actuator"
                }
              }
            },
            "data_source": {
              "const": "live_target"
            },
            "plant_backend": {
              "const": "real_hardware"
            },
            "time_mode": {
              "const": "hardware_realtime"
            },
            "data_plane_profile": {
              "const": "secure_shared_memory"
            },
            "security_profile": {
              "const": "sros2_enforce"
            }
          }
        },
        "authorization": {
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            }
          }
        }
      }
    },
    "realObservationConstraints": {
      "properties": {
        "execution": {
          "properties": {
            "physical_effect": {
              "const": "observation"
            },
            "hardware_scope": {
              "minItems": 1,
              "not": {
                "contains": {
                  "const": "actuator"
                }
              }
            },
            "data_source": {
              "const": "live_target"
            },
            "plant_backend": {
              "const": "real_hardware"
            },
            "time_mode": {
              "const": "hardware_realtime"
            },
            "data_plane_profile": {
              "const": "secure_shared_memory"
            },
            "security_profile": {
              "const": "sros2_enforce"
            }
          }
        },
        "authorization": {
          "properties": {
            "mode": {
              "const": "signed_execution_permit"
            }
          }
        }
      }
    },
    "imported__acceptance-scenario__identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "imported__acceptance-scenario__execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_environment",
        "hardware_scope",
        "physical_effect",
        "test_intent",
        "data_source",
        "plant_backend",
        "time_mode",
        "data_plane_profile",
        "security_profile"
      ],
      "properties": {
        "target_environment": {
          "enum": [
            "simulation",
            "hil",
            "real_robot"
          ]
        },
        "hardware_scope": {
          "type": "array",
          "items": {
            "enum": [
              "compute",
              "sensor",
              "controller",
              "actuator"
            ]
          },
          "uniqueItems": true
        },
        "physical_effect": {
          "enum": [
            "none",
            "observation",
            "actuation"
          ]
        },
        "test_intent": {
          "enum": [
            "interface_smoke",
            "functional",
            "performance",
            "safety_evidence"
          ]
        },
        "data_source": {
          "enum": [
            "gazebo",
            "mcap_playback",
            "live_target"
          ]
        },
        "plant_backend": {
          "enum": [
            "interface_mock",
            "gazebo_physics",
            "recorded_data",
            "real_hardware"
          ]
        },
        "time_mode": {
          "enum": [
            "simulation_realtime",
            "simulation_stepped",
            "playback_clocked",
            "hardware_realtime"
          ]
        },
        "data_plane_profile": {
          "enum": [
            "standard_isolated",
            "local_high_throughput",
            "secure_shared_memory"
          ]
        },
        "security_profile": {
          "enum": [
            "none",
            "sros2_enforce"
          ]
        }
      }
    },
    "imported__acceptance-scenario__sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imported__acceptance-scenario__timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup_sec",
        "graph_ready_sec",
        "stable_for_sec",
        "execution_sec",
        "shutdown_sec"
      ],
      "properties": {
        "startup_sec": {
          "$ref": "#/$defs/imported__acceptance-scenario__positiveSeconds"
        },
        "graph_ready_sec": {
          "$ref": "#/$defs/imported__acceptance-scenario__positiveSeconds"
        },
        "stable_for_sec": {
          "type": "number",
          "minimum": 0
        },
        "execution_sec": {
          "$ref": "#/$defs/imported__acceptance-scenario__positiveSeconds"
        },
        "shutdown_sec": {
          "$ref": "#/$defs/imported__acceptance-scenario__positiveSeconds"
        }
      }
    },
    "imported__acceptance-scenario__positiveSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "imported__acceptance-scenario__expectedRosGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "services",
        "actions",
        "lifecycle_nodes"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imported__acceptance-scenario__topicExpectation"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imported__acceptance-scenario__graphEndpoint"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imported__acceptance-scenario__graphEndpoint"
          }
        },
        "lifecycle_nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imported__acceptance-scenario__lifecycleNode"
          }
        }
      }
    },
    "imported__acceptance-scenario__topicExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "min_publishers",
        "min_subscribers",
        "first_message_timeout_sec"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/imported__acceptance-scenario__rosName"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*/msg/[A-Za-z][A-Za-z0-9_]*$"
        },
        "min_publishers": {
          "type": "integer",
          "minimum": 0
        },
        "min_subscribers": {
          "type": "integer",
          "minimum": 0
        },
        "first_message_timeout_sec": {
          "$ref": "#/$defs/imported__acceptance-scenario__positiveSeconds"
        },
        "qos_profile": {
          "enum": [
            "system_default",
            "sensor_data",
            "services_default",
            "parameters"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "min_publishers": {
              "minimum": 1
            }
          }
        },
        {
          "properties": {
            "min_subscribers": {
              "minimum": 1
            }
          }
        }
      ]
    },
    "imported__acceptance-scenario__rosName": {
      "type": "string",
      "pattern": "^/[^\\s]+$"
    },
    "imported__acceptance-scenario__graphEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "server_required"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/imported__acceptance-scenario__rosName"
        },
        "type": {
          "$ref": "#/$defs/imported__acceptance-scenario__rosType"
        },
        "server_required": {
          "const": true
        }
      }
    },
    "imported__acceptance-scenario__rosType": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*/(?:msg|srv|action)/[A-Za-z][A-Za-z0-9_]*$"
    },
    "imported__acceptance-scenario__lifecycleNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_state",
        "timeout_sec",
        "stable_for_sec"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/imported__acceptance-scenario__rosName"
        },
        "required_state": {
          "const": "active"
        },
        "timeout_sec": {
          "$ref": "#/$defs/imported__acceptance-scenario__positiveSeconds"
        },
        "stable_for_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "imported__acceptance-scenario__assertion": {
      "oneOf": [
        {
          "$ref": "#/$defs/imported__acceptance-scenario__metricAssertion"
        }
      ]
    },
    "imported__acceptance-scenario__metricAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "kind",
        "metric_name",
        "unit",
        "aggregation",
        "operator",
        "threshold",
        "window_sec",
        "attribute_match"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "#/$defs/imported__acceptance-scenario__identifier"
        },
        "kind": {
          "const": "metric"
        },
        "metric_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "aggregation": {
          "enum": [
            "min",
            "max",
            "mean",
            "p50",
            "p95",
            "p99",
            "count"
          ]
        },
        "operator": {
          "enum": [
            "lt",
            "lte",
            "eq",
            "gte",
            "gt"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "window_sec": {
          "$ref": "#/$defs/imported__acceptance-scenario__positiveSeconds"
        },
        "attribute_match": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "imported__acceptance-scenario__timePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_authority_min_samples",
        "max_clock_offset_p50_ms",
        "max_clock_offset_p95_ms",
        "max_clock_offset_ms"
      ],
      "properties": {
        "min_realtime_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_deadline_miss_ratio": {
          "$ref": "#/$defs/imported__acceptance-scenario__ratio"
        },
        "step_size_sec": {
          "$ref": "#/$defs/imported__acceptance-scenario__positiveSeconds"
        },
        "max_skipped_steps": {
          "type": "integer",
          "minimum": 0
        },
        "playback_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_clock_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "message_order": {
          "enum": [
            "received",
            "sent"
          ]
        },
        "qos_overrides_sha256": {
          "$ref": "#/$defs/imported__acceptance-scenario__sha256"
        },
        "clock_sync_protocol": {
          "enum": [
            "ptp",
            "chrony_ntp",
            "mavlink_timesync",
            "micro_xrce_dds",
            "external"
          ]
        },
        "max_clock_offset_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_clock_offset_p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_clock_offset_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "time_authority_min_samples": {
          "type": "integer",
          "minimum": 30
        },
        "max_clock_drift_ppm": {
          "type": "number",
          "minimum": 0
        },
        "max_message_age_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "imported__acceptance-scenario__ratio": {
      "type": "number",
