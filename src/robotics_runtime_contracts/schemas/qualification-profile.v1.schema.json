{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:qualification-profile",
  "title": "Robotics provider qualification profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "provider_kind", "requirements", "trust_policy_sha256"],
  "properties": {
    "schema_version": {"const": "qualification-profile.v1"},
    "profile_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
    "provider_kind": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "trust_policy_sha256": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "required"],
      "properties": {
        "capability": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
        "required": {"type": "boolean"},
        "minimum_version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
