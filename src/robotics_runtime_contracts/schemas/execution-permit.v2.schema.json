{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:execution-permit:v2",
  "title": "Robotics execution permit v2",
  "description": "Short-lived two-party approval predicate bound to an immutable physical target identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "predicate_type",
    "permit_id",
    "scenario_sha256",
    "image_digest",
    "trust_policy_sha256",
    "target",
    "allowed_physical_effect",
    "hardware_scope",
    "issued_at",
    "expires_at",
    "nonce",
    "operator_id",
    "approver_id",
    "interlock_check"
  ],
  "properties": {
    "schema_version": {
      "const": "execution-permit.v2"
    },
    "predicate_type": {
      "const": "https://robotics-runtime-contracts.dev/attestations/execution-permit/v2"
    },
    "permit_id": {
      "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/identifier"
    },
    "scenario_sha256": {
      "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/sha256"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "trust_policy_sha256": {
      "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/sha256"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "allowed_physical_effect": {
      "enum": [
        "none",
        "observation"
      ]
    },
    "hardware_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "compute",
          "sensor",
          "controller"
        ]
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{32,128}$"
    },
    "operator_id": {
      "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/principal"
    },
    "approver_id": {
      "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/principal"
    },
    "interlock_check": {
      "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/interlockCheck"
    },
    "extensions": {
      "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "required": [
              "environment"
            ],
            "properties": {
              "environment": {
                "const": "hil"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "allowed_physical_effect": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "required": [
              "environment"
            ],
            "properties": {
              "environment": {
                "const": "real_robot"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "allowed_physical_effect": {
            "const": "observation"
          }
        }
      }
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "target_id",
        "identity_kind",
        "identity_sha256"
      ],
      "properties": {
        "environment": {
          "enum": [
            "hil",
            "real_robot"
          ]
        },
        "target_id": {
          "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/identifier"
        },
        "identity_kind": {
          "enum": [
            "udev_serial",
            "pci_device",
            "mavlink_system_component",
            "x509_spki",
            "tpm_ek",
            "vendor_soc"
          ]
        },
        "identity_sha256": {
          "$ref": "urn:robotics-runtime-contracts:execution-permit:v1#/$defs/sha256"
        }
      }
    }
  }
}
