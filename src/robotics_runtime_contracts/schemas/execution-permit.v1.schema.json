{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:execution-permit:v1",
  "title": "Robotics execution permit",
  "description": "Short-lived approval predicate for hardware-in-the-loop and real-robot execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "predicate_type",
    "permit_id",
    "scenario_sha256",
    "image_digest",
    "target",
    "allowed_physical_effect",
    "hardware_scope",
    "issued_at",
    "expires_at",
    "nonce",
    "operator_id",
    "approver_id",
    "interlock_check"
  ],
  "properties": {
    "schema_version": {
      "const": "execution-permit.v1"
    },
    "predicate_type": {
      "const": "https://robotics-runtime-contracts.dev/attestations/execution-permit/v1"
    },
    "permit_id": {
      "$ref": "#/$defs/identifier"
    },
    "scenario_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "allowed_physical_effect": {
      "enum": [
        "none",
        "observation",
        "actuation"
      ]
    },
    "hardware_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "compute",
          "sensor",
          "controller",
          "actuator"
        ]
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{32,128}$"
    },
    "operator_id": {
      "$ref": "#/$defs/principal"
    },
    "approver_id": {
      "$ref": "#/$defs/principal"
    },
    "interlock_check": {
      "$ref": "#/$defs/interlockCheck"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "environment": {
                "const": "hil"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "allowed_physical_effect": {
            "const": "none"
          },
          "hardware_scope": {
            "not": {
              "contains": {
                "const": "actuator"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "environment": {
                "const": "real_robot"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "allowed_physical_effect": {
            "enum": [
              "observation",
              "actuation"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "principal": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/-]{2,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "target_id"
      ],
      "properties": {
        "environment": {
          "enum": [
            "hil",
            "real_robot"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "interlockCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "sha256",
        "status",
        "checked_at"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^(?:https|s3|oci)://[^\\s]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "passed"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
