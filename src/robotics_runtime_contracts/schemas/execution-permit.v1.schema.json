{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:execution-permit",
  "title": "Robotics execution permit v1",
  "description": "Short-lived two-party approval predicate bound to an immutable physical target identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "predicate_type",
    "permit_id",
    "scenario_sha256",
    "subject_digest",
    "trust_policy_sha256",
    "target",
    "allowed_physical_effect",
    "hardware_scope",
    "issued_at",
    "expires_at",
    "nonce",
    "operator_id",
    "approver_id",
    "interlock_check"
  ],
  "properties": {
    "schema_version": {
      "const": "execution-permit.v1"
    },
    "predicate_type": {
      "const": "https://robotics-runtime-contracts.dev/attestations/execution-permit/v1"
    },
    "permit_id": {
      "$ref": "#/$defs/imported__execution-permit__identifier"
    },
    "scenario_sha256": {
      "$ref": "#/$defs/imported__execution-permit__sha256"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "trust_policy_sha256": {
      "$ref": "#/$defs/imported__execution-permit__sha256"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "allowed_physical_effect": {
      "enum": [
        "none",
        "observation"
      ]
    },
    "hardware_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "compute",
          "sensor",
          "controller"
        ]
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{32,128}$"
    },
    "operator_id": {
      "$ref": "#/$defs/imported__execution-permit__principal"
    },
    "approver_id": {
      "$ref": "#/$defs/imported__execution-permit__principal"
    },
    "interlock_check": {
      "$ref": "#/$defs/imported__execution-permit__interlockCheck"
    },
    "extensions": {
      "$ref": "#/$defs/imported__execution-permit__extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "required": [
              "environment"
            ],
            "properties": {
              "environment": {
                "const": "hil"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "allowed_physical_effect": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "required": [
              "environment"
            ],
            "properties": {
              "environment": {
                "const": "real_robot"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "allowed_physical_effect": {
            "const": "observation"
          }
        }
      }
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "target_id",
        "identity_kind",
        "identity_sha256"
      ],
      "properties": {
        "environment": {
          "enum": [
            "hil",
            "real_robot"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/imported__execution-permit__identifier"
        },
        "identity_kind": {
          "enum": [
            "udev_serial",
            "pci_device",
            "mavlink_system_component",
            "x509_spki",
            "tpm_ek",
            "vendor_soc"
          ]
        },
        "identity_sha256": {
          "$ref": "#/$defs/imported__execution-permit__sha256"
        }
      }
    },
    "imported__execution-permit__identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "imported__execution-permit__sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imported__execution-permit__principal": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/-]{2,255}$"
    },
    "imported__execution-permit__interlockCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "sha256",
        "status",
        "checked_at"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "sha256": {
          "$ref": "#/$defs/imported__execution-permit__sha256"
        },
        "status": {
          "const": "passed"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "imported__execution-permit__extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
