{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:qualification-bundle",
  "title": "Robotics qualification bundle v1",
  "description": "An in-toto Statement that names every artifact in one qualification run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "predicateType": {
      "const": "https://robotics-runtime-contracts.dev/attestations/qualification-bundle/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "generated_at",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "qualification-bundle.v1"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifacts": {
          "type": "array",
          "minItems": 7,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "scenario",
            "acceptance_observation",
            "runtime_manifest",
            "acceptance_run",
            "domain_result",
            "acceptance_aggregate",
            "transport_qualification",
            "evidence_index",
            "recording_summary",
            "metrics",
            "traces",
            "junit",
            "causal_chain_contract",
            "channel_contract",
            "channel_observation",
            "clock_relation",
            "provider_conformance",
            "artifact_receipt",
            "qualification_profile",
            "model_manifest",
            "dataset_manifest",
            "execution_permit",
            "execution_verification",
            "policy",
            "recording",
            "other_evidence"
          ]
        },
        "subject_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
