{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:acceptance-result:v3",
  "title": "Robotics acceptance result v3",
  "description": "Acceptance result with physical authorization, forbidden-interface observations, and hardware timing evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "scenario_sha256",
    "runtime_manifest_sha256",
    "started_at",
    "finished_at",
    "monotonic_duration_sec",
    "status",
    "assertion_results",
    "observed_ros_graph",
    "forbidden_graph_observation",
    "execution",
    "authorization",
    "workload",
    "lifecycle_states",
    "clock_observation",
    "shutdown",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-result.v3"
    },
    "result_id": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/identifier"
    },
    "scenario_sha256": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/sha256"
    },
    "runtime_manifest_sha256": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/sha256"
    },
    "model_manifest_sha256": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/sha256"
    },
    "dataset_manifest_sha256": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/sha256"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_duration_sec": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "error",
        "cancelled"
      ]
    },
    "assertion_results": {
      "type": "array",
      "items": {
        "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/assertionResult"
      }
    },
    "observed_ros_graph": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/observedRosGraph"
    },
    "forbidden_graph_observation": {
      "$ref": "#/$defs/forbiddenGraphObservation"
    },
    "execution": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/execution"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "workload": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v2#/$defs/workload"
    },
    "lifecycle_states": {
      "type": "array",
      "items": {
        "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/lifecycleState"
      }
    },
    "clock_observation": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/clockObservation"
    },
    "hardware_clock_observation": {
      "$ref": "#/$defs/hardwareClockObservation"
    },
    "shutdown": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/shutdown"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/evidence"
      }
    },
    "extensions": {
      "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "assertion_results": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          },
          "forbidden_graph_observation": {
            "properties": {
              "passed": {
                "const": true
              },
              "violations": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "execution"
        ],
        "properties": {
          "execution": {
            "required": [
              "target_environment"
            ],
            "properties": {
              "target_environment": {
                "const": "simulation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          }
        },
        "not": {
          "required": [
            "hardware_clock_observation"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "execution"
        ],
        "properties": {
          "execution": {
            "required": [
              "target_environment"
            ],
            "properties": {
              "target_environment": {
                "enum": [
                  "hil",
                  "real_robot"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "hardware_clock_observation"
        ],
        "properties": {
          "authorization": {
            "properties": {
              "mode": {
                "const": "verified_execution_permit"
              }
            }
          },
          "execution": {
            "properties": {
              "data_source": {
                "const": "live_target"
              },
              "plant_backend": {
                "const": "real_hardware"
              },
              "time_mode": {
                "const": "hardware_realtime"
              },
              "data_plane_profile": {
                "const": "secure_shared_memory"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "inference"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "model_manifest_sha256"
        ]
      }
    }
  ],
  "$defs": {
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "permit_sha256",
            "execution_verification_sha256",
            "trust_policy_sha256",
            "target"
          ],
          "properties": {
            "mode": {
              "const": "verified_execution_permit"
            },
            "permit_sha256": {
              "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/sha256"
            },
            "execution_verification_sha256": {
              "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/sha256"
            },
            "trust_policy_sha256": {
              "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/sha256"
            },
            "target": {
              "$ref": "urn:robotics-runtime-contracts:execution-permit:v2#/$defs/target"
            }
          }
        }
      ]
    },
    "forbiddenGraphObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "checked_topics",
        "checked_services",
        "checked_actions",
        "violations"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checked_topics": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "checked_services": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "checked_actions": {
          "type": "array",
          "items": {
            "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/rosName"
          },
          "uniqueItems": true
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "topic",
                  "service",
                  "action"
                ]
              },
              "name": {
                "$ref": "urn:robotics-runtime-contracts:acceptance-scenario:v2#/$defs/rosName"
              }
            }
          }
        }
      }
    },
    "hardwareClockObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sync_protocol",
        "source",
        "measured_at",
        "sample_count",
        "offset_ms",
        "jitter_ms",
        "drift_ppm",
        "max_sample_age_ms",
        "within_policy",
        "evidence_sha256"
      ],
      "properties": {
        "sync_protocol": {
          "enum": [
            "ptp",
            "chrony_ntp",
            "mavlink_timesync",
            "micro_xrce_dds",
            "external"
          ]
        },
        "source": {
          "enum": [
            "pmc",
            "chronyc_tracking",
            "mavlink_timesync_status",
            "controller_telemetry",
            "external_attestation"
          ]
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "offset_ms": {
          "type": "number"
        },
        "jitter_ms": {
          "type": "number",
          "minimum": 0
        },
        "drift_ppm": {
          "type": "number"
        },
        "max_sample_age_ms": {
          "type": "number",
          "minimum": 0
        },
        "within_policy": {
          "type": "boolean"
        },
        "evidence_sha256": {
          "$ref": "urn:robotics-runtime-contracts:acceptance-result:v1#/$defs/sha256"
        }
      }
    }
  }
}
