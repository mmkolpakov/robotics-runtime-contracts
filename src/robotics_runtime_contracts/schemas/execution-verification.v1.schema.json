{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:execution-verification:v1",
  "title": "Robotics execution verification v1",
  "description": "Fail-closed record of two independently verified Sigstore execution-permit signatures and policy authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "permit_sha256",
    "statement_sha256",
    "policy_sha256",
    "trust_policy_sha256",
    "target",
    "verified_at",
    "cosign_version",
    "cosign_image_digest",
    "signers",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "execution-verification.v1"
    },
    "verification_id": {
      "$ref": "#/$defs/imported__execution-permit__identifier"
    },
    "permit_sha256": {
      "$ref": "#/$defs/imported__execution-permit__sha256"
    },
    "statement_sha256": {
      "$ref": "#/$defs/imported__execution-permit__sha256"
    },
    "policy_sha256": {
      "$ref": "#/$defs/imported__execution-permit__sha256"
    },
    "trust_policy_sha256": {
      "$ref": "#/$defs/imported__execution-permit__sha256"
    },
    "target": {
      "$ref": "#/$defs/imported__execution-permit__target"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "cosign_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+\\.[0-9]+$"
    },
    "cosign_image_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/signer"
      }
    },
    "decision": {
      "const": "allow"
    },
    "extensions": {
      "$ref": "#/$defs/imported__execution-permit__extensions"
    }
  },
  "$defs": {
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "identity",
        "issuer",
        "bundle_sha256",
        "integrated_time",
        "transparency_log_verified"
      ],
      "properties": {
        "role": {
          "enum": [
            "operator",
            "approver"
          ]
        },
        "identity": {
          "$ref": "#/$defs/imported__execution-permit__principal"
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/imported__execution-permit__sha256"
        },
        "integrated_time": {
          "type": "integer",
          "minimum": 0
        },
        "transparency_log_verified": {
          "const": true
        }
      }
    },
    "imported__execution-permit__identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "imported__execution-permit__sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imported__execution-permit__target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "target_id",
        "identity_kind",
        "identity_sha256"
      ],
      "properties": {
        "environment": {
          "enum": [
            "hil",
            "real_robot"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/imported__execution-permit__identifier"
        },
        "identity_kind": {
          "enum": [
            "udev_serial",
            "pci_device",
            "mavlink_system_component",
            "x509_spki",
            "tpm_ek",
            "vendor_soc"
          ]
        },
        "identity_sha256": {
          "$ref": "#/$defs/imported__execution-permit__sha256"
        }
      }
    },
    "imported__execution-permit__extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "imported__execution-permit__principal": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:/-]{2,255}$"
    }
  }
}
