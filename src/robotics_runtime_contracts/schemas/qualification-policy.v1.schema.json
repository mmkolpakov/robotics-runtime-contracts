{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:qualification-policy",
  "title": "Robotics qualification verification policy v1",
  "description": "An independently distributed trust policy for offline Sigstore verification of qualification statements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "predicate_type",
    "certificate_identities",
    "certificate_oidc_issuer",
    "trusted_root_sha256",
    "required_artifact_kinds"
  ],
  "properties": {
    "schema_version": {
      "const": "qualification-policy.v1"
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "predicate_type": {
      "const": "https://robotics-runtime-contracts.dev/attestations/qualification-bundle/v1"
    },
    "certificate_identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 1024
      }
    },
    "certificate_oidc_issuer": {
      "type": "string",
      "format": "uri",
      "maxLength": 1024
    },
    "trusted_root_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "required_artifact_kinds": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactKind"
      },
      "allOf": [
        {
          "contains": {
            "const": "scenario"
          }
        },
        {
          "contains": {
            "const": "runtime_manifest"
          }
        },
        {
          "contains": {
            "const": "acceptance_run"
          }
        },
        {
          "contains": {
            "const": "domain_result"
          }
        },
        {
          "contains": {
            "const": "acceptance_aggregate"
          }
        },
        {
          "contains": {
            "const": "evidence_index"
          }
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactKind": {
      "enum": [
        "scenario",
        "acceptance_observation",
        "runtime_manifest",
        "acceptance_run",
        "domain_result",
        "acceptance_aggregate",
        "transport_qualification",
        "evidence_index",
        "recording_summary",
        "metrics",
        "traces",
        "junit",
        "causal_chain_contract",
        "channel_contract",
        "channel_observation",
        "clock_relation",
        "provider_conformance",
        "artifact_receipt",
        "qualification_profile",
        "model_manifest",
        "dataset_manifest",
        "execution_permit",
        "execution_verification",
        "policy",
        "recording",
        "other_evidence"
      ]
    }
  }
}
