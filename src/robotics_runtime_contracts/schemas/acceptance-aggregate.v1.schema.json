{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:acceptance-aggregate:v1",
  "title": "Robotics acceptance aggregate v1",
  "description": "Run-scoped aggregate of complete per-domain verdicts before cross-domain trace evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aggregate_id",
    "run_id",
    "acceptance_run_sha256",
    "generated_at",
    "per_domain_results",
    "per_domain_aggregate",
    "cross_domain_e2e"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-aggregate.v1"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^aggregate-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "acceptance_run_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "per_domain_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domainResult"
      }
    },
    "per_domain_aggregate": {
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "error",
        "cancelled"
      ]
    },
    "cross_domain_e2e": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unevaluated"
        },
        "reason": {
          "const": "trace_evidence_not_evaluated"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "domainResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "result_id",
        "result_sha256",
        "status"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "result_id": {
          "type": "string",
          "pattern": "^result-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "error",
            "cancelled"
          ]
        }
      }
    }
  }
}
