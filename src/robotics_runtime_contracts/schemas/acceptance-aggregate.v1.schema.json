{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:acceptance-aggregate",
  "title": "Robotics acceptance aggregate v1",
  "description": "Per-domain acceptance results with an optional reference to a separately qualified cross-domain transport result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aggregate_id",
    "run_id",
    "acceptance_run_sha256",
    "generated_at",
    "per_domain_results",
    "per_domain_aggregate",
    "cross_domain_e2e"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-aggregate.v1"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^aggregate-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "acceptance_run_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "per_domain_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domainResult"
      }
    },
    "per_domain_aggregate": {
      "$ref": "#/$defs/domainStatus"
    },
    "cross_domain_e2e": {
      "oneOf": [
        {
          "$ref": "#/$defs/unevaluatedTransport"
        },
        {
          "$ref": "#/$defs/evaluatedTransport"
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "domainStatus": {
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "error",
        "cancelled"
      ]
    },
    "transportStatus": {
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "error"
      ]
    },
    "domainResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "result_id",
        "result_sha256",
        "status"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "result_id": {
          "type": "string",
          "pattern": "^result-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "$ref": "#/$defs/domainStatus"
        }
      }
    },
    "unevaluatedTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unevaluated"
        },
        "reason": {
          "const": "transport_qualification_not_provided"
        }
      }
    },
    "evaluatedTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "transport_qualification"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/transportStatus"
        },
        "transport_qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "qualification_id",
            "result_sha256",
            "status"
          ],
          "properties": {
            "qualification_id": {
              "type": "string",
              "pattern": "^qualification-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "result_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "$ref": "#/$defs/transportStatus"
            }
          }
        }
      }
    }
  }
}
