{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:acceptance-aggregate:v3",
  "title": "Robotics acceptance aggregate v3",
  "description": "Run-scoped domain verdicts with an explicit unevaluated or qualified cross-domain causality state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aggregate_id",
    "run_id",
    "acceptance_run_sha256",
    "generated_at",
    "per_domain_results",
    "per_domain_aggregate",
    "cross_domain_e2e"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-aggregate.v3"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^aggregate-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "acceptance_run_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "base_aggregate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "per_domain_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domainResult"
      }
    },
    "per_domain_aggregate": {
      "$ref": "#/$defs/domainStatus"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version"
      ],
      "properties": {
        "implementation": {
          "const": "robotics-acceptance-harness"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "maxLength": 64
        }
      }
    },
    "trace_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/traceEvidence"
      }
    },
    "causal_chain_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/causalChainContract"
      }
    },
    "channel_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/channelContract"
      }
    },
    "channel_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/channelObservation"
      }
    },
    "causal_chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/causalChain"
      }
    },
    "cross_domain_e2e": {
      "oneOf": [
        {
          "$ref": "#/$defs/unevaluatedVerdict"
        },
        {
          "$ref": "#/$defs/evaluatedVerdict"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cross_domain_e2e": {
            "$ref": "#/$defs/unevaluatedVerdict"
          }
        }
      },
      "then": {
        "properties": {
          "base_aggregate_sha256": false,
          "evaluator": false,
          "trace_evidence": false,
          "causal_chain_contracts": false,
          "channel_contracts": false,
          "channel_observations": false,
          "causal_chains": false
        }
      },
      "else": {
        "required": [
          "base_aggregate_sha256",
          "evaluator",
          "trace_evidence",
          "causal_chain_contracts",
          "channel_contracts",
          "channel_observations",
          "causal_chains"
        ]
      }
    }
  ],
  "$defs": {
    "unevaluatedVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unevaluated"
        },
        "reason": {
          "const": "trace_evidence_not_evaluated"
        }
      }
    },
    "evaluatedVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluated_at",
        "chain_count",
        "passed_chain_count",
        "failed_chain_count",
        "incomplete_chain_count",
        "error_chain_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "error"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "chain_count": {
          "type": "integer",
          "minimum": 1
        },
        "passed_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_chain_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "domainStatus": {
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "error",
        "cancelled"
      ]
    },
    "causalChainContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "sha256"
      ],
      "properties": {
        "chain_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "domainResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "result_id",
        "result_sha256",
        "status"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "result_id": {
          "type": "string",
          "pattern": "^result-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "$ref": "#/$defs/domainStatus"
        }
      }
    },
    "traceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "evidence_index_sha256",
        "segment_index",
        "uri",
        "media_type",
        "format",
        "signal",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "const": "application/x-ndjson"
        },
        "format": {
          "const": "otlp-jsonl"
        },
        "signal": {
          "const": "traces"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "channelContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "source_domain_id",
        "destination_domain_id",
        "sha256"
      ],
      "properties": {
        "channel_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "destination_domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "channelObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "observation_id",
        "sha256",
        "status"
      ],
      "properties": {
        "channel_id": {
          "$ref": "#/$defs/identifier"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^observation-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "error"
          ]
        }
      }
    },
    "spanReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "trace_id",
        "span_id",
        "message_id"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "missing_trace_evidence",
            "missing_span",
            "trace_id_mismatch",
            "relationship_mismatch",
            "temporal_order_mismatch",
            "message_id_mismatch",
            "channel_observation_failed",
            "domain_result_not_passed",
            "evaluation_error"
          ]
        },
        "channel_id": {
          "$ref": "#/$defs/identifier"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "hop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "relationship",
        "producer",
        "consumer",
        "status",
        "violations"
      ],
      "properties": {
        "channel_id": {
          "$ref": "#/$defs/identifier"
        },
        "relationship": {
          "enum": [
            "link",
            "parent"
          ]
        },
        "producer": {
          "$ref": "#/$defs/spanReference"
        },
        "consumer": {
          "$ref": "#/$defs/spanReference"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/violation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "violations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "causalChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "expected_contract_sha256",
        "channel_ids",
        "status",
        "hops",
        "violations"
      ],
      "properties": {
        "chain_id": {
          "$ref": "#/$defs/identifier"
        },
        "expected_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "root_trace_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "trace_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "channel_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "error"
          ]
        },
        "hops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hop"
          }
        },
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/violation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "root_trace_id",
              "trace_ids"
            ],
            "properties": {
              "hops": {
                "minItems": 1
              },
              "violations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
