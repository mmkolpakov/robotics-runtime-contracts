{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:v1:conformance-result",
  "title": "Robotics provider conformance result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "run_id",
    "generated_at",
    "qualification_profile_sha256",
    "execution_subject_digest",
    "provider",
    "target_id",
    "status",
    "capabilities",
    "checks",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "conformance-result.v1"},
    "result_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
    "run_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/runId"},
    "generated_at": {"type": "string", "format": "date-time"},
    "qualification_profile_sha256": {
      "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sha256"
    },
    "execution_subject_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "provider": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/providerIdentity"},
    "scene": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/sceneObservation"},
    "target_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
    "status": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/status"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"}
    },
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "evidence": {
      "type": "array",
      "items": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/artifactRef"}
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "capability", "status", "observed_value"],
      "properties": {
        "check_id": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
        "capability": {"$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/identifier"},
        "status": {
          "description": "Normative verdict produced by the qualified check implementation.",
          "$ref": "urn:robotics-runtime-contracts:v1:internal:common#/$defs/status"
        },
        "observed_value": {
          "description": "Informational measurement; it has no intrinsic truth semantics.",
          "type": ["number", "integer", "string", "boolean", "null"]
        },
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "maxLength": 4096}
      }
    }
  }
}
