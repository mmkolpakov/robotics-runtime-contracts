{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-runtime-contracts:acceptance-run:v1",
  "title": "Acceptance run context",
  "description": "Immutable context created before an acceptance execution starts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "scenario_id",
    "scenario_sha256",
    "time_authority",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "const": "acceptance-run.v1"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scenario_id": {
      "$ref": "#/$defs/identifier"
    },
    "scenario_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "time_authority": {
      "$ref": "#/$defs/timeAuthority"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "role"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "timeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sim_clock",
            "playback_clock",
            "ptp",
            "chrony_ntp",
            "mavlink_timesync",
            "external"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
