{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmkolpakov.github.io/robotics-runtime-contracts/schemas/ros-graph-contract.v1.schema.json",
  "title": "RosGraphContractV1",
  "type": "object",
  "required": [
    "schema_version",
    "graph_ready_timeout_sec",
    "topics"
  ],
  "properties": {
    "schema_version": { "const": "ros-graph-contract.v1" },
    "graph_ready_timeout_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "publisher_match", "subscriber_match"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "publisher_match": {
            "type": "object",
            "required": ["min_count", "timeout_sec"],
            "properties": {
              "min_count": { "type": "integer", "minimum": 0 },
              "timeout_sec": { "type": "integer", "minimum": 1, "maximum": 600 }
            },
            "additionalProperties": false
          },
          "subscriber_match": {
            "type": "object",
            "required": ["min_count", "timeout_sec"],
            "properties": {
              "min_count": { "type": "integer", "minimum": 0 },
              "timeout_sec": { "type": "integer", "minimum": 1, "maximum": 600 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
