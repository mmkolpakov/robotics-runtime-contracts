{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmkolpakov.github.io/robotics-runtime-contracts/schemas/evidence-manifest.v1.schema.json",
  "title": "EvidenceManifestV1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "result",
    "scenario",
    "artifacts",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "evidence-manifest.v1" },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "error"]
    },
    "scenario": {
      "type": "object",
      "required": ["scenario_id", "resolved_manifest_sha256"],
      "properties": {
        "scenario_id": { "type": "string" },
        "resolved_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "uri", "sha256", "bytes"],
        "properties": {
          "name": { "type": "string" },
          "uri": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "retention": {
            "$ref": "artifact-store-policy.v1.schema.json#/definitions/retention"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "skip"]
          },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
